# SQL Server connection (auto-discovers all databases)
SQL_SERVER_HOST=your_host
SQL_SERVER_PORT=1433
SQL_SERVER_USER=your_user
SQL_SERVER_PASSWORD=your_password

# Groq API Key
GROQ_API_KEY=your_groq_api_key

# Catalog database (internal metadata store)
CATALOG_DB_HOST=localhost
CATALOG_DB_PORT=1433
CATALOG_DB_NAME=data_governance_catalog
CATALOG_DB_USER=your_user
CATALOG_DB_PASSWORD=your_password
